# Public template only. Copy to credentials.env and restrict permissions to 600.
# Literal KEY=value; no shell evaluation or variable expansion. Keep secrets out of chat.
# Leave providers disabled until their connection fields are filled.

WIND_MYSQL_ENABLED=false
WIND_MYSQL_HOST=
WIND_MYSQL_PORT=3306
WIND_MYSQL_DATABASE=
WIND_MYSQL_USER=
WIND_MYSQL_PASSWORD=
# Explicit opt-in: disabled for a Wind endpoint without TLS; never auto-downgrade.
WIND_MYSQL_TLS_MODE=verify_identity
WIND_MYSQL_SSL_CA=
# Units of the actual database must be checked before setting these multipliers.
WIND_MYSQL_VOLUME_MULTIPLIER=
WIND_MYSQL_AMOUNT_MULTIPLIER=
WIND_MYSQL_DERIVATIVES_AMOUNT_MULTIPLIER=

JYDB_MYSQL_ENABLED=false
JYDB_MYSQL_HOST=
JYDB_MYSQL_PORT=3306
JYDB_MYSQL_DATABASE=
JYDB_MYSQL_USER=
JYDB_MYSQL_PASSWORD=
JYDB_MYSQL_SSL_CA=
JYDB_MYSQL_SSL_CA_SHA256=
JYDB_MYSQL_TLS_MODE=verify_identity
# Optional only after checking the currency of every financial table used by this profile.
# Otherwise financial currency is null and the result is partial.
JYDB_MYSQL_FINANCIAL_CURRENCY=

# Recent intraday web bars through the optional AKShare SDK. No API key required.
AKSHARE_ENABLED=true
# Historical intraday provider intentionally unconfigured; see source_policy().

# Web material discovery credentials; never forwarded to document origins.
BOCHA_API_KEY=
EXA_API_KEY=
# Reserved for future material search integration; legacy clients use process env.
TAVILY_API_KEY=
ANYSEARCH_API_KEY=
# Unified material search: direct public web discovery + bounded original reading.
WEB_MATERIALS_ENABLED=false
# regional: CN -> Bocha, overseas -> WEB_OVERSEAS_PROVIDER. Fixed bocha/anysearch/exa supported.
WEB_SEARCH_PROVIDER=regional
# Explicit recommendation for new installs; omitted on old installs retains AnySearch.
WEB_OVERSEAS_PROVIDER=exa
# Anonymous discovery is opt-in; a configured key is never replaced or auto-created.
WEB_ALLOW_ANONYMOUS=false
# Optional comma-separated domains; enforced on discovered URLs and redirects.
WEB_ALLOWED_DOMAINS=
# Official Knowledge Planet MCP credential; never a browser Cookie/Authorization value.
ZSXQ_KEY=
ZSXQ_MATERIALS_ENABLED=false
# Private ordered collection allowlist; empty discovers one directory page at query time.
ZSXQ_GROUP_IDS=
ZSXQ_MAX_GROUPS_PER_QUERY=3
ZSXQ_MAX_PAGES_PER_GROUP=2
# Comments consume the same text-read budget as topic details. 0 disables them.
ZSXQ_COMMENTS_PER_TOPIC=0
DAJIALA_KEY=
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=
# Tushare large-model corpus MCP subscription; separate from the legacy HTTP API token.
# Explicitly enable the independently registered research/news/policy material adapter.
# Enter only the token, never the full authenticated MCP URL.
TUSHARE_MCP_TOKEN=
TUSHARE_CORPUS_ENABLED=false
TUSHARE_CORPUS_MAX_CALLS_PER_QUERY=3
TUSHARE_CORPUS_NEWS_SOURCE=新浪财经
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
IMA_API_KEY=

# FMP stable US company profiles, basic daily prices and standardized annual statements.
# Enable only after filling the private key. Upgrading the plan does not auto-enable endpoints.
FMP_ENABLED=false
FMP_API_KEY=
# Worst-case HTTP calls per query, checked before network access (1..25).
FMP_MAX_REQUESTS_PER_QUERY=5
# Latest annual rows requested from EACH selected statement endpoint (1..100).
FMP_ANNUAL_RECORD_LIMIT=5
# Memory-only response cache; 0 disables. No cross-process daily quota accounting.
FMP_CACHE_TTL_SECONDS=60

# eastmoney: OHLCV/turnover; sina: OHLC only until activity units are verified.
AKSHARE_STOCK_BACKEND=eastmoney

# WeChat account timelines via Dajiala; DAJIALA_KEY is declared above.
# Inventory is private JSON, relative to this env file, owner-only mode 600.
WECHAT_MATERIALS_ENABLED=false
WECHAT_ACCOUNTS_FILE=.local/wechat_accounts.json
WECHAT_MAX_ACCOUNTS_PER_QUERY=3
WECHAT_MAX_PAGES_PER_ACCOUNT=2
WECHAT_CACHE_DIR=.local/wechat-cache

# IMA official OpenAPI; enable only after supplying both private values.
IMA_CLIENT_ID=
IMA_MATERIALS_ENABLED=false
IMA_INCLUDE_NOTES=true
# Comma-separated discovery scope; empty discovers a bounded first directory page.
IMA_KNOWLEDGE_BASE_IDS=
IMA_MAX_KNOWLEDGE_BASES=3
IMA_MAX_PAGES=2

# Wisburg official MCP: stored reports, articles and commentary.
# WISBERG_KEY is a supported legacy alias; do not configure conflicting values.
WISBURG_MATERIALS_ENABLED=false
WISBURG_API_KEY=
WISBURG_MAX_CALLS_PER_QUERY=20
WISBURG_MAX_PAGES_PER_CATEGORY=1

# Community/video material discovery (Bocha CN, AnySearch YouTube).
XUEQIU_MATERIALS_ENABLED=false
EASTMONEY_MATERIALS_ENABLED=false
VIDEO_MATERIALS_ENABLED=false
XUEQIU_COOKIE=
# Experimental browser reader; live Xueqiu article acceptance still blocked.
# Install .[browser] and matching Chromium; see docs/xueqiu_browser_repair.md.
# http keeps the minimal dependency path. browser uses an isolated native browser.
XUEQIU_READ_MODE=http
XUEQIU_BROWSER_USE_COOKIE=false
XUEQIU_BROWSER_HEADLESS=true
XUEQIU_BROWSER_CHANNEL=chromium
BILIBILI_COOKIE=

# Xiaoyuzhou public metadata + explicit Volcengine Agent Plan streaming ASR.
# Install .[audio] and FFmpeg. Never put real keys in this template.
XIAOYUZHOU_MATERIALS_ENABLED=false
VOLC_ASR_ENABLED=false
VOLC_ASR_PLAN=agent_plan
VOLC_ASR_MODEL=doubao-seed-asr-2.0
VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/plan/sauc/bigmodel_nostream
AUDIO_CACHE_DIR=.local/audio-cache
VOLC_ASR_API_KEY=

# Optional YouTube DNS: system (default) or google_doh, only www.youtube.com.
YOUTUBE_DNS_MODE=system

# SEC EDGAR original filings: free public API; supply a real contact, no API key.
SEC_MATERIALS_ENABLED=false
SEC_USER_AGENT=""
# e.g. ir-search Your-Contact-Email (fill locally; never publish personal configuration)
SEC_MAX_HISTORY_FILES=2

# Fiona MCP only: Authorization: Bearer, fixed official Fiona data endpoints.
# FIONA_MCP (existing local name) is accepted as an alias. Never use this as a Finoview REST appkey/appsecret.
FIONA_MCP_ENABLED=false
FIONA_MCP_TOKEN=
FIONA_MAX_CALLS_PER_QUERY=20
# AlphaPai shared meetings via web account (optional browser extra; no Open API key).
ALPHAPAI_MATERIALS_ENABLED=false
ALPHA_PIE_PHONE=
ALPHA_PIE_PWD=
ALPHAPAI_BROWSER_EXECUTABLE=
ALPHAPAI_CACHE_DIR=
ALPHAPAI_CACHE_TTL_SECONDS=3600
ALPHAPAI_MAX_PAGES=2
ALPHAPAI_MAX_CALLS=12

# Gangtise stored materials via account; device verification is completed locally.
# Existing GANTISE_PHONE / GANTISE_PWD names are supported.
GANGTISE_MATERIALS_ENABLED=false
GANTISE_PHONE=
GANTISE_PWD=
GANGTISE_BROWSER_EXECUTABLE=
GANGTISE_STATE_DIR=
GANGTISE_MAX_PAGES=2
GANGTISE_MAX_CALLS=12

# Xiaohongshu: optional local xpzouying/xiaohongshu-mcp HTTP service, user QR login.
# Match the service AUTH_TOKEN; use a randomly generated value of at least 16 characters.
# Bind the service to 127.0.0.1 only. Never publish this token or the private cookie/cache files.
XHS_MATERIALS_ENABLED=false
XHS_BACKEND_URL=http://127.0.0.1:18060
XHS_BACKEND_TOKEN=
XHS_CACHE_DIR=.local/xhs-cache

# Optional RSS/Atom discovery and explicit cloud web reading.
# FIRECRAWL_API_KEY is only sent to api.firecrawl.dev. Auto mode never uses it.
RSS_ENABLED=false
RSS_FEED_URLS='["https://www.federalreserve.gov/feeds/press_all.xml", "https://www.ecb.europa.eu/rss/press.html"]'
FIRECRAWL_ENABLED=false
FIRECRAWL_API_KEY=

# Official public series and HKEX / reviewed issuer IR; no API key
GLOBAL_MACRO_ENABLED=false
HKEX_ENABLED=false
COMPANY_IR_ENABLED=false
